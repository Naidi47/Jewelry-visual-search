# ============================================================
# Jewelry Visual Search - .gitignore
# ============================================================

# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# Never commit real Kubernetes secrets
k8s/secret.yaml
k8s/*-secret.yaml
!k8s/secret-template.yaml


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg


# ------------------------------------------------------------
# Python Virtual Environments
# ------------------------------------------------------------
venv/
.venv/
env/
ENV/


# ------------------------------------------------------------
# Python Testing / Coverage
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/


# ------------------------------------------------------------
# AI / Hugging Face / Model Cache
# ------------------------------------------------------------
model_cache/
.cache/
huggingface/

*.bin
*.safetensors
*.pt
*.pth
*.onnx


# ------------------------------------------------------------
# Jewelry Dataset / Generated Embeddings
# ------------------------------------------------------------

# Large catalog images should not be committed to Git
data/jewelry_catalog/catalog/
data/test_catalog/catalog/

# Other generated/local image files
data/*.jpg
data/*.jpeg
data/*.png
data/*.webp

# Keep metadata/sample catalog files
!data/sample_products.json
!data/jewelry_catalog/sample_products.json
!data/test_catalog/sample_products.json


# ------------------------------------------------------------
# Frontend - Node / React / Vite
# ------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Frontend environment variables
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# npm debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# IDE / Editors
# ------------------------------------------------------------
.idea/
.vscode/

*.swp
*.swo
*~


# ------------------------------------------------------------
# Operating System
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------------------------
# Logs / Runtime Files
# ------------------------------------------------------------
*.log
logs/
*.pid
*.pid.lock


# ------------------------------------------------------------
# Temporary Files
# ------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak


# ------------------------------------------------------------
# Docker Local Overrides / Volumes
# ------------------------------------------------------------
docker-data/
mongodb-data/


# ------------------------------------------------------------
# Local Generated Archives
# ------------------------------------------------------------
*.zip
*.tar
*.tar.gz